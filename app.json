{
  "expo": {
    "name": "My Life 1.0",
    "slug": "my-life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adyl0022.mylife"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0f2c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.adyl0022.mylife",
      "backgroundColor": "#0a0f2c",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "mylife",
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": "development"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "My Life uses your location to find your JAKIM prayer zone and the Qibla direction."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6a4df0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "My Life lets you attach photos of receipts and documents to your records."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "My Life counts your steps to fill in your daily habit goal."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow My Life to use Face ID to unlock the app."
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0f2c",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "backgroundColor": "#0a0f2c"
  }
}
