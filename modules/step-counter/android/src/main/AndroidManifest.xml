<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <service
      android:name="expo.modules.stepcounter.SleepTileService"
      android:exported="true"
      android:icon="@drawable/ic_sleep_tile"
      android:label="Going to sleep"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
    <receiver android:name="expo.modules.stepcounter.SleepActionReceiver" android:exported="false" />
  </application>
</manifest>
